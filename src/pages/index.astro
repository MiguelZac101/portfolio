---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";

import ReactJourney from "../components/ReactJourney.astro";
import Projects from "../components/Projects.astro";

const developerDescription = "Web Developer — PHP, Laravel, WordPress & React";
const pageTitle = `Miguel Zack | ${developerDescription}`;
---

<Layout
    title={pageTitle}
    description={pageTitle}
    developerDescription={developerDescription}
>
    <main class="min-h-screen portfolio-main">
        <div
            class="mx-auto max-w-6xl grid grid-cols-1 lg:grid-cols-[1fr_3fr] gap-8 lg:gap-10 px-6 py-12 lg:py-24"
        >
            <Sidebar developerDescription={developerDescription} />

            <section class="space-y-8">
                <Projects />

                <ReactJourney />

                <footer class="portfolio-footer pt-12 text-xs">
                    Made with Astro. <a
                        href="https://github.com/MiguelZac101/portfolio"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline underline-offset-2 decoration-accent">View code</a
                    >
                </footer>
            </section>
        </div>
    </main>
</Layout>
