---
interface Props {
    title: string;
    desc: string;
    image: string;
    demo: string;
    loom_id: string;
    repo: string;
    tech: string[];
}
const { title, desc, image, demo, loom_id, repo, tech } = Astro.props;
const modalId = `modal-${title.replace(/\s+/g, '-').toLowerCase()}`;
---
<article class="group border border-secondary-muted rounded-xl p-6 bg-secondary text-primary hover:border-accent transition-colors">
    <img
        src={image}
        alt={`Screenshot de ${title}`}
        class="rounded-lg mb-5 object-cover bg-secondary-muted"
        loading="lazy"
    />
    <h3 class="text-xl font-semibold mb-2">{title}</h3>
    <p class="text-primary-muted mb-4 text-sm leading-relaxed">{desc}</p>
    <div class="flex flex-wrap gap-2 mb-5">
        {tech.map((t) => (
            <span class="text-xs bg-secondary-muted border border-secondary-muted px-2.5 py-1 rounded-md text-primary">
                {t}
            </span>
        ))}
    </div>
    <div class="flex gap-5">
        {demo && (
            <a href={demo} target="_blank" rel="noopener noreferrer"
                class="text-primary text-sm font-medium underline underline-offset-4 decoration-accent hover:decoration-2 transition-all">
                Live Demo →
            </a>
        )}
        <a href={repo} target="_blank" rel="noopener noreferrer"
            class="text-primary text-sm font-medium underline underline-offset-4 decoration-accent hover:decoration-2 transition-all">
            GitHub →
        </a>
        {loom_id && (
            <button
                data-modal={modalId}
                class="text-primary text-sm font-medium underline underline-offset-4 decoration-accent hover:decoration-2 transition-all cursor-pointer">
                Preview →
            </button>
        )}
    </div>
</article>

{loom_id && (
    <div id={modalId} class="fixed inset-0 bg-primary/95 z-50 hidden items-center justify-center !mt-0">
        <div class="relative w-full max-w-5xl mx-4">
            <button data-close={modalId} class="absolute -top-8 right-0 text-secondary text-sm">
                ✕ Cerrar
            </button>
            <div class="relative w-full aspect-video">
                <div class="loading-spinner absolute inset-0 rounded-lg bg-secondary-muted animate-pulse flex items-center justify-center">
                    <div class="w-12 h-12 border-4 border-secondary-muted border-t-accent rounded-full animate-spin" />
                </div>
                <iframe
                    data-src={`https://www.loom.com/embed/${loom_id}`}
                    frameborder="0"
                    allowfullscreen
                    class="absolute inset-0 w-full h-full rounded-lg opacity-0 transition-opacity duration-300"
                />
            </div>
        </div>
    </div>
)}

<script>
    document.querySelectorAll('[data-modal]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-modal')!
            const modal = document.getElementById(id)!
            const iframe = modal.querySelector('iframe')!

            abrirModal(id)

            iframe.src = iframe.dataset.src!
            modal.classList.remove('hidden')
            modal.classList.add('flex')
        })
    })

    document.querySelectorAll('[data-close]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-close')!
            cerrarModal(id)
        })
    })

    document.querySelectorAll('[data-modal]').forEach((btn) => {
        const id = btn.getAttribute('data-modal')!
        const modal = document.getElementById(id)!
        modal.addEventListener('click', (e) => {
            if (e.target === modal) cerrarModal(id)
        })
    })

    function cerrarModal(id:string) {
        const modal = document.getElementById(id)!
        const iframe = modal.querySelector('iframe')!
        iframe.src = ''
        modal.classList.add('hidden')
        modal.classList.remove('flex')
    }

    function abrirModal(id: string) {
        const modal = document.getElementById(id)!
        const iframe = modal.querySelector('iframe')!
        const spinner = modal.querySelector('.loading-spinner') as HTMLElement

        iframe.src = iframe.dataset.src!
        modal.classList.remove('hidden')
        modal.classList.add('flex')

        spinner.classList.remove('hidden')
        iframe.classList.add('opacity-0')

        iframe.addEventListener('load', () => {
            spinner.classList.add('hidden')
            iframe.classList.remove('opacity-0')
        }, { once: true })
    }
</script>
