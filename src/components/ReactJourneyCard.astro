---
import type { JourneyItem } from "../types/index.ts";

interface Props {
	item: JourneyItem;
}
const { item } = Astro.props;
---

<div class="portfolio-card relative p-4 border rounded-xl">
	<p class="mb-2 text-xs text-secondary">{item.date}</p>
	{
    item.in_progress && (
		<span class="absolute top-4 right-4 text-xs bg-primary text-secondary border border-accent px-2 py-0.5 rounded-full">
			In progress
		</span>
    )
	}
	<h3 class="mb-1 text-base font-semibold">{item.title}</h3>
	<p class="mb-3 text-xs leading-relaxed text-secondary">{item.description}</p>
	<a
		href={item.resource_url}
		target="_blank"
		rel="noopener noreferrer"
		class="block group"
	>
		<img
			src={item.image}
			alt={item.resource_label}
			class="object-cover w-full mb-2 transition-opacity rounded-lg group-hover:opacity-80"
		/>
		<p class="text-xs transition-colors text-secondary group-hover:text-accent underline decoration-accent underline-offset-2">
			{item.resource_label}
		</p>
		<p class="text-xs text-secondary">{item.channel}</p>
	</a>

</div>