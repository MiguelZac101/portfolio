---
import type { JourneyItem } from "../types/index.ts";

interface Props {
	item: JourneyItem;
}
const { item } = Astro.props;
---

<div class="relative p-4 transition-colors border border-zinc-800 rounded-xl hover:border-zinc-700">
	<p class="mb-2 text-xs text-zinc-500">{item.date}</p>
	{
    item.in_progress && (
		<span class="absolute top-4 right-4 text-xs bg-yellow-400/10 text-yellow-400 border border-yellow-400/20 px-2 py-0.5 rounded-full">
			In progress
		</span>
    )
	}
	<h3 class="mb-1 text-base font-semibold">{item.title}</h3>
	<p class="mb-3 text-xs leading-relaxed text-zinc-400">{item.description}</p>
	<a
		href={item.resource_url}
		target="_blank"
		rel="noopener noreferrer"
		class="block group"
	>
		<img
			src={item.image}
			alt={item.resource_label}
			class="object-cover w-full mb-2 transition-opacity rounded-lg group-hover:opacity-80"
		/>
		<p class="text-xs transition-colors text-zinc-400 group-hover:text-white">
			{item.resource_label}
		</p>
		<p class="text-xs text-zinc-600">{item.channel}</p>
	</a>

</div>