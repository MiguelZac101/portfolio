---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  developerName: string;
  developerDescription: string;
}

const { title, description, developerName, developerDescription } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:inline>
      html {
        background: #0B1F3A;
      }

      #page-loader {
        display: none;
      }

      html.page-loading {
        overflow: hidden;
      }

      html.page-loading:not(.page-opening) #page-content {
        visibility: hidden;
      }

      html.page-loading #page-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: block;
        color: #F5F3EE;
        font-family: system-ui, sans-serif;
      }

      .page-loader-panel {
        position: absolute;
        box-sizing: border-box;
        left: 0;
        width: 100%;
        height: 50%;
        display: flex;
        align-items: center;
        flex-direction: column;
        background: #0B1F3A;
        text-align: center;
        transition: transform 1.6s cubic-bezier(0.65, 0, 0.35, 1);
        will-change: transform;
      }

      .page-loader-top {
        top: 0;
        justify-content: flex-end;
        padding: 0 1.5rem 0.35rem;
      }

      .page-loader-bottom {
        bottom: 0;
        justify-content: flex-start;
        padding: 0.35rem 1.5rem 0;
      }

      .page-loader-name {
        font-size: clamp(2.5rem, 7vw, 5rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.1;
      }

      .page-loader-description {
        color: var(--color-accent, #E87524);
        font-size: clamp(0.95rem, 2.8vw, 1.3rem);
        line-height: 1.5;
      }

      html.page-opening .page-loader-top {
        transform: translateY(-100%);
      }

      html.page-opening .page-loader-bottom {
        transform: translateY(100%);
      }

    </style>
    <script is:inline>
      document.documentElement.classList.add('page-loading');
      const loadingStarted = Date.now();
      let pageOpening = false;

      const loadingTimeout = window.setTimeout(() => {
        console.error('Page loading timed out; displaying the content.');
        openPage();
      }, 10000);

      function openPage() {
        if (pageOpening) return;
        pageOpening = true;
        window.clearTimeout(loadingTimeout);
        const loader = document.getElementById('page-loader');
        const topPanel = loader?.querySelector('.page-loader-top');
        const finish = () => {
          document.documentElement.classList.remove('page-loading', 'page-opening');
          loader?.remove();
        };

        if (!topPanel) {
          finish();
          return;
        }

        const cleanupTimeout = window.setTimeout(finish, 1800);
        topPanel.addEventListener('transitionend', (event) => {
          if (event.target === topPanel && event.propertyName === 'transform') {
            window.clearTimeout(cleanupTimeout);
            finish();
          }
        });
        topPanel.getBoundingClientRect();
        document.documentElement.classList.add('page-opening');
      }

      window.addEventListener('load', () => {
        if (pageOpening) return;
        window.clearTimeout(loadingTimeout);
        const remaining = Math.max(0, 900 - (Date.now() - loadingStarted));
        window.setTimeout(openPage, remaining);
      }, { once: true });
    </script>
  </head>
  <body>
    <div id="page-loader" role="status" aria-label="Cargando página">
      <div class="page-loader-panel page-loader-top" aria-hidden="true">
        <span class="page-loader-name">{developerName}</span>
      </div>
      <div class="page-loader-panel page-loader-bottom" aria-hidden="true">
        <span class="page-loader-description">{developerDescription}</span>
      </div>
    </div>
    <div id="page-content">
      <slot />
    </div>
  </body>
</html>